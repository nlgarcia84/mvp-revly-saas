generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// User: Cuenta de usuario registrada con Supabase Auth.
// Se crea automáticamente al registrarse (signUp).
// Relación 1:N con Business — un usuario puede tener
// varios negocios asociados.
// subscription vincula su plan de pago.
// ──────────────────────────────────────────────
model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  businesses   Business[]
  subscription Subscription?
}

// ──────────────────────────────────────────────
// Subscription: Plan de pago asociado a un usuario.
// stripeCustomerId — ID del cliente en Stripe.
// stripeSubscriptionId — ID de la suscripción en Stripe.
// plan — "free" | "pro".
// status — "active" | "inactive" | "past_due" | "canceled".
// ──────────────────────────────────────────────
model Subscription {
  id                   String    @id @default(uuid())
  plan                 String    @default("free")
  status               String    @default("active")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// ──────────────────────────────────────────────
// Business: Negocio registrado por un usuario.
// slug se genera automáticamente desde el nombre y se
// usa en la URL pública para que los clientes dejen
// sus datos (revly.es/{slug}).
// googleLink es opcional — enlace para reseña en Google.
// emailTemplate es opcional — texto personalizado para
// el email de invitación. Si está vacío se usa el
// mensaje por defecto.
// ──────────────────────────────────────────────
model Business {
  id            String     @id @default(uuid())
  name          String
  googleLink    String?
  image         String?
  slug          String?   @unique
  emailTemplate String?
  verificationPin String?  // PIN de 4 dígitos para canje en caja
  invoiceFormat String?    // Ejemplo: "FACT-001" — se muestra al cliente al canjear facturas
  userId        String
  createdAt     DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customers     Customer[]
  invoices      Invoice[]

  // ── Google Business Profile ────────────────────────
  // Si el usuario conecta su cuenta de Google Business
  // Profile (OAuth), guardamos aquí los tokens y los IDs
  // de su cuenta y ubicación en Google. Así podemos usar
  // la API de Business Profile para traer TODAS las
  // reseñas en lugar de solo las 5 que da Places API.
  googleBusinessAccessToken  String?   // token OAuth para llamar a la API
  googleBusinessRefreshToken String?   // token para renovar el access token cuando caduca
  googleBusinessTokenExpiry  DateTime? // cuándo caduca el access token
  googleBusinessAccountId    String?   // ID de la cuenta en Google Business Profile
  googleBusinessLocationId   String?   // ID de la ubicación/local en Google Business Profile
  // ─────────────────────────────────────────────────

  // ── Instagram / Meta Graph API ──────────────────────
  // Si el usuario conecta su Instagram profesional
  // (Business/Creator vinculado a una página de Facebook),
  // guardamos aquí el token (long-lived, 60 días) y los
  // IDs de la página de Facebook y de la cuenta de
  // Instagram. Así podemos leer comentarios y responder
  // desde el dashboard con la ayuda de la IA.
  instagramAccessToken     String?   // token long-lived de Meta (60 días)
  instagramTokenExpiry     DateTime? // cuándo caduca el access token (60 días)
  instagramPageId          String?   // ID de la página de Facebook vinculada
  instagramBusinessAccountId String? // ID de la cuenta profesional de Instagram (IGSID)
  instagramUsername        String?   // nombre de usuario de Instagram (para mostrarlo en Settings)
  // ─────────────────────────────────────────────────

  @@unique([name, userId])
}

// ──────────────────────────────────────────────
// Invoice: Factura registrada por el negocio para
// que el cliente la canjee y sume puntos.
// Cada número de factura solo puede usarse una vez.
// El negocio da de alta los números; el cliente
// los introduce en su perfil público para canjear.
// Una vez canjeado (customerId + usedAt), queda
// bloqueado para siempre.
// ──────────────────────────────────────────────
model Invoice {
  id         String    @id @default(uuid())
  number     String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([number, businessId])
}

model Customer {
  id            String    @id @default(uuid())
  name          String?
  email         String
  phone         String
  businessId    String
  source        String    @default("qr")
  status        String    @default("pending")
  invitedCount  Int       @default(0)
  lastInvitedAt DateTime?
  rating        Int?
  feedback      String?
  // ── Sistema de puntos y descuentos ──────────────────
  // "points" se incrementa cada vez que el cliente
  // rellena el formulario (1 punto por envío). Cuando
  // acumula 5 puntos, puede canjear un 10% de descuento.
  // "discountCode" es un código único (ej: REVLY-A3X9)
  // que se genera al crear el cliente y se muestra en
  // su perfil público con un barcode.
  points        Int       @default(1)
  discountCode  String?
  // ─────────────────────────────────────────────────
  createdAt     DateTime  @default(now())
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoices      Invoice[]

  @@unique([email, businessId])
}