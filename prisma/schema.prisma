generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// User: Cuenta de usuario registrada con Supabase Auth.
// Se crea automáticamente al registrarse (signUp).
// Relación 1:N con Business — un usuario puede tener
// varios negocios asociados.
// subscription vincula su plan de pago.
// ──────────────────────────────────────────────
model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  businesses   Business[]
  subscription Subscription?
}

// ──────────────────────────────────────────────
// Subscription: Plan de pago asociado a un usuario.
// stripeCustomerId — ID del cliente en Stripe.
// stripeSubscriptionId — ID de la suscripción en Stripe.
// plan — "free" | "pro".
// status — "active" | "inactive" | "past_due" | "canceled".
// ──────────────────────────────────────────────
model Subscription {
  id                   String    @id @default(uuid())
  plan                 String    @default("free")
  status               String    @default("active")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// ──────────────────────────────────────────────
// Business: Negocio registrado por un usuario.
// slug se genera automáticamente desde el nombre y se
// usa en la URL pública para que los clientes dejen
// sus datos (revly.es/{slug}).
// googleLink es opcional — enlace para reseña en Google.
// emailTemplate es opcional — texto personalizado para
// el email de invitación. Si está vacío se usa el
// mensaje por defecto.
// ticketFormat es opcional — ejemplo del número de ticket
// del kiosko, para mostrarlo como placeholder al cliente.
// ──────────────────────────────────────────────
model Business {
  id            String     @id @default(uuid())
  name          String
  googleLink    String?
  image         String?
  slug          String?   @unique
  emailTemplate String?
  ticketFormat  String?    // Ejemplo: "A-001" — placeholder del ticket del kiosko
  userId         String
  createdAt      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customers      Customer[]
  pointClaims    PointClaim[]
  pointMovements PointMovement[]
  reviewAnalyses ReviewAnalysis[]

  // ── Smart Analytics (propuestas globales) ─────────────
  // Propuestas globales de mejora generadas por IA a partir
  // del análisis agregado de las reseñas. Se regeneran solo
  // cuando aparecen reseñas nuevas; el resto de cargas
  // reutilizan este valor persistido (evita llamadas Groq
  // innecesarias). Es un resultado agregado del negocio, no
  // de una reseña concreta, por eso vive en Business.
  analyticsProposals Json?
  // ─────────────────────────────────────────────────

  // ── Google Business Profile ────────────────────────
  // Si el usuario conecta su cuenta de Google Business
  // Profile (OAuth), guardamos aquí los tokens y los IDs
  // de su cuenta y ubicación en Google. Así podemos usar
  // la API de Business Profile para traer TODAS las
  // reseñas en lugar de solo las 5 que da Places API.
  googleBusinessAccessToken  String?   // token OAuth para llamar a la API
  googleBusinessRefreshToken String?   // token para renovar el access token cuando caduca
  googleBusinessTokenExpiry  DateTime? // cuándo caduca el access token
  googleBusinessAccountId    String?   // ID de la cuenta en Google Business Profile
  googleBusinessLocationId   String?   // ID de la ubicación/local en Google Business Profile
  // ─────────────────────────────────────────────────

  // ── Instagram / Meta Graph API ──────────────────────
  // Si el usuario conecta su Instagram profesional
  // (Business/Creator vinculado a una página de Facebook),
  // guardamos aquí el token (long-lived, 60 días) y los
  // IDs de la página de Facebook y de la cuenta de
  // Instagram. Así podemos leer comentarios y responder
  // desde el dashboard con la ayuda de la IA.
  instagramAccessToken     String?   // token long-lived de Meta (60 días)
  instagramTokenExpiry     DateTime? // cuándo caduca el access token (60 días)
  instagramPageId          String?   // ID de la página de Facebook vinculada
  instagramBusinessAccountId String? // ID de la cuenta profesional de Instagram (IGSID)
  instagramUsername        String?   // nombre de usuario de Instagram (para mostrarlo en Settings)
  instagramCacheAt         DateTime? // cuándo se guardó la última caché de comentarios
  instagramCache           Json?     // resultado de publicaciones+comentarios cacheado en BD
  // ─────────────────────────────────────────────────

  // ── Página de Facebook ──────────────────────────────
  // Si el usuario conecta una Página de Facebook (token de
  // página con pages_show_list), guardamos aquí el token y
  // los IDs para leer comentarios, responder y publicar.
  facebookAccessToken     String?   // token de la Página de Facebook
  facebookTokenExpiry     DateTime? // cuándo caduca el access token
  facebookPageId          String?   // ID de la Página de Facebook
  facebookPageName        String?   // nombre de la página (para Settings)
  facebookUsername        String?   // username/handle de la página si existe
  facebookCacheAt         DateTime? // cuándo se guardó la última caché de comentarios
  facebookCache           Json?     // resultado de publicaciones+comentarios cacheado en BD
  facebookPending         Json?     // páginas pendientes de elegir tras el OAuth (si administra varias)
  // ─────────────────────────────────────────────────

  // ── Programa de puntos ──────────────────────────────
  // loyaltyEnabled permite desactivar el programa de puntos
  // sin borrar datos. Se comprueba en servidor antes de
  // sumar/canjear puntos.
  loyaltyEnabled Boolean @default(true)
  // ─────────────────────────────────────────────────

  // ── Store Locator ─────────────────────────────
  // Información del local que el negocio publica para que
  // sus clientes lo encuentren: dirección, coordenadas
  // (para el mapa), fotos y horarios de apertura.
  // Todos los campos son opcionales: si no se rellenan,
  // el bloque público no se muestra.
  address      String?   // dirección completa ("Carrer de Mallorca 1, Barcelona")
  latitude     Float?    // latitud del local (-90..90)
  longitude    Float?    // longitud del local (-180..180)
  // Horarios de apertura estructurados por día (0=lunes … 6=domingo).
  // {
  //   mode: "hours" | "variable" | "always",
  //   days: [{ day: 0, closed: false, slots: [{ open: "09:00", close: "14:00" }] }]
  // }
  openingHours Json?
  // Fotos del local subida por el negocio (bucket "business-photos").
  // [{ url: "...", path: "<businessId>/<timestamp>.jpg" }] — máximo 8.
  photos       Json?
  // ─────────────────────────────────────────────────

  @@unique([name, userId])
}

// ──────────────────────────────────────────────
// PointMovement: libro de movimientos de puntos
// (historial). Cada alta de punto (+1) y cada canje
// (-5) quedan registrados aquí. No se borra nunca.
//   - "day" (YYYY-MM-DD) se usa solo en movimientos
//     "earn" para imponer el límite de 1 punto/día
//     a nivel de base de datos (evita condiciones de
//     carrera al añadir puntos).
// ──────────────────────────────────────────────
model PointMovement {
  id         String   @id @default(uuid())
  type       String   // "welcome" | "earn" | "redeem" | "adjust"
  points     Int      // firmado: +1 al ganar, -5 al canjear
  day        String?  // "YYYY-MM-DD" (solo en "earn")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
  @@unique([customerId, businessId, type, day])
}

// ──────────────────────────────────────────────
// PointClaim: punto ganado canjeando el código de un
// ticket del kiosko. Sirve de registro antifraude:
//   - Un cliente solo puede reclamar 1 punto al día.
//   - Un mismo ticket solo vale una vez al día por negocio.
// ──────────────────────────────────────────────
model PointClaim {
  id         String   @id @default(uuid())
  ticketCode String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  claimedAt  DateTime @default(now())

  @@index([customerId, claimedAt])
  @@index([businessId, ticketCode, claimedAt])
}

model Customer {
  id            String    @id @default(uuid())
  name          String?
  email         String
  phone         String
  whatsappOptIn Boolean   @default(false) // el cliente acepta recibir avisos por WhatsApp
  businessId    String
  source        String    @default("qr")
  status        String    @default("pending")
  invitedCount  Int       @default(0)
  lastInvitedAt DateTime?
  rating        Int?
  feedback      String?
  // ── Sistema de puntos y descuentos ──────────────────
  // "points" empieza en 1 al registrarse. Luego solo sube
  // canjeando el código del ticket del kiosko (1 punto/día).
  // Cuando acumula 5 puntos, puede canjear un 10% de descuento.
  // "discountCode" es un código único (ej: REVLY-A3X9)
  // que se genera al crear el cliente y se muestra en
  // su perfil público con un QR.
  points        Int       @default(1)
  discountCode  String?
  // ── Identificador seguro del QR personal ─────────
  // "qrToken" es un token aleatorio opaco que codifica
  // el QR del cliente. No contiene puntos, datos ni nada
  // manipulable: solo sirve para localizar al cliente en
  // el servidor.
  qrToken       String?   @unique
  // ─────────────────────────────────────────────────
  createdAt     DateTime  @default(now())
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pointClaims   PointClaim[]
  pointMovements PointMovement[]

  @@unique([email, businessId])
}

// ──────────────────────────────────────────────
// ReviewAnalysis: análisis generado por IA (Smart Analytics)
// de una reseña de Google. NO copia la reseña completa;
// solo guarda el resultado del análisis (sentimiento,
// categorías, aspectos positivos/negativos y resumen).
// Identifica la reseña por source + externalReviewId
// (reviewName de Business Profile, o id determinista).
// ──────────────────────────────────────────────
model ReviewAnalysis {
  id               String   @id @default(uuid())
  businessId       String
  source           String
  externalReviewId String

  sentiment        String
  categories       Json
  positiveAspects  Json
  negativeAspects  Json
  summary          String

  analyzedAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, source, externalReviewId])
  @@index([businessId, source])
}
