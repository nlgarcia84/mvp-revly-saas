generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// User: Cuenta de usuario registrada con Supabase Auth.
// Se crea automáticamente al registrarse (signUp).
// Relación 1:N con Business — un usuario puede tener
// varios negocios asociados.
// ──────────────────────────────────────────────
model User {
  id         String     @id @default(uuid())
  email      String     @unique
  name       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  businesses Business[]
}

// ──────────────────────────────────────────────
// Business: Negocio registrado por un usuario.
// slug se genera automáticamente desde el nombre y se
// usa en la URL pública para que los clientes dejen
// sus datos (revly.es/{slug}).
// googleLink es opcional — enlace para reseña en Google.
// emailTemplate es opcional — texto personalizado para
// el email de invitación. Si está vacío se usa el
// mensaje por defecto.
// ──────────────────────────────────────────────
model Business {
  id            String     @id @default(uuid())
  name          String
  googleLink    String?
  slug          String?   @unique
  emailTemplate String?
  userId        String
  createdAt     DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customers     Customer[]
}

// ──────────────────────────────────────────────
// Customer: Cliente que ha rellenado el formulario
// público de un negocio. Solo se crea si el usuario
// aceptó la política de privacidad (consent).
// Cada cliente pertenece a un único negocio.
// invitedCount: número de veces que se le ha enviado
// la invitación. Se incrementa en cada envío.
// lastInvitedAt: fecha del último envío.
// ──────────────────────────────────────────────
model Customer {
  id            String    @id @default(uuid())
  name          String?
  email         String
  phone         String
  businessId    String
  source        String    @default("qr")
  status        String    @default("pending")
  invitedCount  Int       @default(0)
  lastInvitedAt DateTime?
  rating        Int?
  createdAt     DateTime  @default(now())
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([email, businessId])
}